[Desktop Entry]
Type=Application
Name=Amplia
GenericName=Audio Player
Comment=A native audio player with the behaviour of Winamp
Comment[pt_BR]=Tocador de áudio nativo com o comportamento do Winamp
Exec=amplia %U
Icon=io.github.cassiofiorin.Amplia
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-wav;audio/mp4;audio/x-m4a;
StartupWMClass=Amplia
Keywords=audio;music;player;mp3;flac;ogg;
Keywords[pt_BR]=áudio;música;tocador;mp3;flac;ogg;
